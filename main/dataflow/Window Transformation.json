{
	"name": "Window Transformation",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_empdata",
						"type": "DatasetReference"
					},
					"name": "Empdata"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "window1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          EMPNO as string,",
				"          ENAME as string,",
				"          JOB as string,",
				"          MGR as string,",
				"          HIREDATE as string,",
				"          SAL as float,",
				"          COMM as string,",
				"          DEPTNO as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> Empdata",
				"Empdata window(over(DEPTNO),",
				"     asc(SAL, true),",
				"     AvgSalary = avg(SAL),",
				"          totalemp = count(EMPNO)) ~> window1"
			]
		}
	}
}