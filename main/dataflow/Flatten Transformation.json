{
	"name": "Flatten Transformation",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "sample_json",
						"type": "DatasetReference"
					},
					"name": "sample"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "flatten1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id as string,",
				"          type as string,",
				"          name as string,",
				"          image as (url as string, width as integer, height as integer),",
				"          thumbnail as (url as string, width as integer, height as integer),",
				"          batters as (batter as (id as string, type as string)[]),",
				"          topping as (id as string, type as string)[]",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     documentForm: 'documentPerLine') ~> sample",
				"sample foldDown(unrollMultiple(,),",
				"     mapColumn(",
				"          id,",
				"          type,",
				"          name,",
				"          image,",
				"          thumbnail,",
				"          batters,",
				"          topping",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> flatten1"
			]
		}
	}
}