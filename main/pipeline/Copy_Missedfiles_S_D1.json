{
	"name": "Copy_Missedfiles_S_D",
	"properties": {
		"activities": [
			{
				"name": "Source Metadata",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "Blob_Source",
						"type": "DatasetReference"
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobStorageReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "Destination Metadata",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "destinationcontainer",
						"type": "DatasetReference"
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobStorageReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "Source Count",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Source Metadata",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "Sourcefilecount",
					"value": {
						"value": "@{length(activity('Source Metadata').output.childItems)}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Destination Count",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Destination Metadata",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "Destinationfilecount",
					"value": {
						"value": "@{length(activity('Destination Metadata').output.childItems)}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Missing Files count",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Source Count",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Destination Count",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "Missedfilescount",
					"value": {
						"value": "@{sub(int(variables('Sourcefilecount')),int(variables('Destinationfilecount')))}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Check missed files",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Missing Files count",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(variables('Missedfilescount'),0)",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Check missed file names",
							"type": "Filter",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"items": {
									"value": "@activity('Source Metadata').output.childItems",
									"type": "Expression"
								},
								"condition": {
									"value": "@not(contains(activity('Destination Metadata').output.childItems,item()))",
									"type": "Expression"
								}
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "Wait1",
							"type": "Wait",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"waitTimeInSeconds": 2
							}
						}
					]
				}
			}
		],
		"variables": {
			"Sourcefilecount": {
				"type": "String"
			},
			"Destinationfilecount": {
				"type": "String"
			},
			"Missedfilescount": {
				"type": "String"
			}
		},
		"annotations": []
	}
}