{
	"name": "Copy_Missedfiles_S_D",
	"properties": {
		"activities": [
			{
				"name": "Source Metadata",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "Blob_Source",
						"type": "DatasetReference"
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobStorageReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "Destination Metadata",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "destinationcontainer",
						"type": "DatasetReference"
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobStorageReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "Source Count",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Source Metadata",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "Sourcefilecount",
					"value": {
						"value": "@{length(activity('Source Metadata').output.childItems)}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Destination Count",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Destination Metadata",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "Destinationfilecount",
					"value": {
						"value": "@{length(activity('Destination Metadata').output.childItems)}",
						"type": "Expression"
					}
				}
			}
		],
		"variables": {
			"Sourcefilecount": {
				"type": "String"
			},
			"Destinationfilecount": {
				"type": "String"
			},
			"Missedfilescount": {
				"type": "String"
			}
		},
		"annotations": []
	}
}